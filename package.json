{
	"name": "@jrussellsmyth/fit-cli",
	"version": "1.4.7-cli.0",
	"description": "A CLI tool for autonomous agent and CI pipeline management of an Obsidian (https://obsidian.md) vault, built on top of FIT (https://github.com/joshuakto/fit).",
	"keywords": [],
	"homepage": "https://github.com/jrussellsmyth/fit#readme",
	"bugs": {
		"url": "https://github.com/jrussellsmyth/fit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jrussellsmyth/fit.git"
	},
	"license": "MIT",
	"author": "jrussell.smyth@gmail.com",
	"type": "module",
	"main": "main.js",
	"files": [
		"fit-cli.cjs",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"fit-cli": "fit-cli.cjs"
	},
	"directories": {
		"doc": "docs",
		"test": "test"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"cli:build": "node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"lint": "eslint",
		"lint:fix": "eslint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "wdio run ./test/e2e/wdio.conf.mts",
		"test:mobile": "wdio run ./test/e2e/wdio.mobile-emulation.conf.mts",
		"test:android": "wdio run ./test/e2e/wdio.mobile.conf.mts",
		"test:all": "npm run test && npm run test:e2e && npm run test:mobile && npm run test:android",
		"start:mobile": "./scripts/mobile-simple.sh",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepack": "cp README.md README.orig.md && cp README.cli.md README.md",
		"postpack": "mv README.orig.md README.md"
	},
	"dependencies": {
		"@octokit/core": "^7.0.6",
		"@octokit/plugin-retry": "^8.0.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@stylistic/eslint-plugin": "^5.7.0",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.16.0",
		"@typescript-eslint/eslint-plugin": "^8.53.0",
		"@typescript-eslint/parser": "^8.53.0",
		"@vitest/coverage-istanbul": "^4.0.8",
		"@vitest/ui": "^4.0.8",
		"@wdio/cli": "^9.23.0",
		"@wdio/globals": "^9.23.0",
		"@wdio/local-runner": "^9.23.0",
		"@wdio/mocha-framework": "^9.23.0",
		"@wdio/spec-reporter": "^9.20.0",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.27.2",
		"eslint": "^9.39.2",
		"expect-webdriverio": "^5.6.1",
		"globals": "^17.0.0",
		"happy-dom": "^20.0.11",
		"mocha": "^11.7.5",
		"obsidian": "^1.8.7",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2",
		"vitest": "^4.0.8",
		"wdio-obsidian-reporter": "^2.1.6",
		"wdio-obsidian-service": "^2.1.6"
	},
	"optionalDependencies": {
		"@wdio/appium-service": "^9.23.0",
		"appium": "^2.19.0",
		"appium-uiautomator2-driver": "^3.10.0"
	}
}
